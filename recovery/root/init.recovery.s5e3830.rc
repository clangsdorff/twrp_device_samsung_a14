on init
    write /proc/sys/kernel/hung_task_timeout_secs 0

    # USB (dwc3 configfs gadget)
    setprop sys.usb.controller 13600000.dwc3
    setprop sys.usb.configfs 1

    start watchdogd

on fs
    symlink /dev/block/platform/12100000.dwmmc0 /dev/block/bootdevice
    exec_start fstab-crypto

on boot
    setprop servicemanager.ready true
    setprop twrp.decrypt.run 1
    # the ramdisk keystore2 cannot reach the firmware KeyMint and restarts every 5 seconds
    stop keystore2
    # the bootloader passes usb_restrict=1 into recovery, and usb_notify then kills adb, MTP and OTG
    write /sys/module/usb_notify_layer/parameters/usb_restrict 0
    # it also withholds OTG until a lock state is reported, which never happens without the framework
    write /sys/class/usb_notify/usb_control/usb_sl SUNNY_WORK_MODE

on property:twrp.decrypt.run=1
    start decrypt

# s3c2410_wdt is armed as soon as its module loads in first stage.
# Feed it every 10s with a 20s margin, like stock recovery.
service watchdogd /system/bin/watchdogd 10 20
    user root
    oneshot
    seclabel u:r:watchdogd:s0

# TEEGRIS hashes the exec'd image, so these two must not go through the bootstrap linker
service tee-tzdaemon /vendor/bin/tzdaemon
    class main
    user root
    group root system readproc
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw
    seclabel u:r:recovery:s0
    disabled

service tee-tzts /vendor/bin/tzts_daemon
    class main
    user root
    group root system
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw
    seclabel u:r:recovery:s0
    disabled

service tee-servicemanager /system/bin/hal_run.sh /rom/system/bin/servicemanager
    class core
    user root
    group root readproc
    seclabel u:r:recovery:s0
    disabled

service tee-keymint /system/bin/hal_run.sh /vendor/bin/hw/android.hardware.security.keymint-service
    class main
    user root
    group root system drmrpc
    seclabel u:r:recovery:s0
    disabled

service tee-gatekeeper /system/bin/hal_run.sh /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    class main
    user root
    group root system
    seclabel u:r:recovery:s0
    disabled

# runs before the recovery binary parses the fstab, so one image serves encrypted and plain firmware
service fstab-crypto /system/bin/fstab_crypto.sh
    user root
    group root system
    seclabel u:r:recovery:s0
    oneshot
    disabled

service decrypt /system/bin/decrypt.sh
    class main
    user root
    group root system
    seclabel u:r:recovery:s0
    oneshot
    disabled
