+bool TWPartitionManager::Resize_Super_Volume(TWPartition* twrpPart, uint64_t size) {
+	std::string bare_partition_name = Get_Bare_Partition_Name(twrpPart->Get_Mount_Point());
+	std::string partition_name = bare_partition_name;
+	uint32_t slot = 0;
+#ifdef AB_OTA_UPDATER
+	partition_name += Get_Active_Slot_Suffix();
+	slot = android::fs_mgr::SlotNumberForSlotSuffix(Get_Active_Slot_Suffix());
+#endif
+	std::string super_device = Get_Super_Partition();
+
+	auto builder = MetadataBuilder::New(super_device, slot);
+	if (!builder) {
+		LOGERR("Unable to read metadata from %s\n", super_device.c_str());
+		return false;
+	}
+	auto partition = builder->FindPartition(partition_name);
+	if (!partition) {
+		LOGERR("%s is not in the super metadata\n", partition_name.c_str());
+		return false;
+	}
+	if (!builder->ResizePartition(partition, size)) {
+		LOGINFO("Not enough space in super to resize %s to %llu bytes\n", partition_name.c_str(), (unsigned long long)size);
+		gui_err("img_size_err=Size of image is larger than target device");
+		return false;
+	}
+	auto metadata = builder->Export();
+	if (!metadata) {
+		LOGERR("Unable to build new metadata for %s\n", partition_name.c_str());
+		return false;
+	}
+
+	// only replace a link this recovery made, never a by-name entry for a physical partition
+	std::string link = "/dev/block/bootdevice/by-name/" + bare_partition_name;
+	char target[PATH_MAX];
+	ssize_t len = readlink(link.c_str(), target, sizeof(target) - 1);
+	bool own_link = len < 0 ? errno == ENOENT : std::string(target, len) == twrpPart->Actual_Block_Device;
+
+	if (!DestroyLogicalPartition(partition_name)) {
+		LOGERR("Unable to unmap %s, it is still in use\n", partition_name.c_str());
+		return false;
+	}
+	// like fastbootd, only the slot in use: the other metadata slots of a non-A/B super hold stale tables
+	bool updated = android::fs_mgr::UpdatePartitionTable(super_device, *metadata, slot);
+	if (!updated)
+		LOGERR("Unable to write metadata to %s\n", super_device.c_str());
+
+	// maps the new table, or the old one again when it was not written
+	android::fs_mgr::CreateLogicalPartitionParams params;
+	params.block_device = super_device;
+	params.metadata_slot = slot;
+	params.partition_name = partition_name;
+	params.force_writable = true;
+	params.timeout_ms = std::chrono::seconds(10);
+	std::string path;
+	if (!android::fs_mgr::CreateLogicalPartition(params, &path)) {
+		LOGERR("Unable to map %s, reboot the recovery before using it\n", partition_name.c_str());
+		// the old dm node may be handed to another device
+		if (own_link)
+			unlink(link.c_str());
+		twrpPart->Set_Block_Device("");
+		return false;
+	}
+	twrpPart->Set_Block_Device(path);
+	if (own_link) {
+		unlink(link.c_str());
+		if (symlink(path.c_str(), link.c_str()) != 0)
+			LOGINFO("Unable to link %s to %s\n", link.c_str(), path.c_str());
+	}
+	return updated;
+}
