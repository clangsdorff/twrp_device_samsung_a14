diff --git a/libtar/fscrypt_refs.h b/libtar/fscrypt_refs.h
new file mode 100644
index 0000000..d2f0783
--- /dev/null
+++ b/libtar/fscrypt_refs.h
@@ -0,0 +1,60 @@
+#ifndef FSCRYPT_REFS_H
+#define FSCRYPT_REFS_H
+
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+/* written by langsdorff_decrypt as "<DK|DE<user>|CE<user>> <key identifier hex>" for each key it installs */
+#define FSCRYPT_REFS "/tmp/.fscrypt_refs"
+#define FSCRYPT_REFS_ID_SIZE 16
+
+static inline int fscrypt_refs_parse(const char *hex, uint8_t *id)
+{
+	int i;
+	unsigned int b;
+
+	for (i = 0; i < FSCRYPT_REFS_ID_SIZE; i++) {
+		if (sscanf(hex + 2 * i, "%2x", &b) != 1)
+			return 0;
+		id[i] = (uint8_t)b;
+	}
+	return 1;
+}
+
+/* key identifier -> "DK", "DE0", "CE0" */
+static inline int fscrypt_refs_name(const uint8_t *id, char *name, size_t len)
+{
+	char n[16], h[2 * FSCRYPT_REFS_ID_SIZE + 1];
+	uint8_t cur[FSCRYPT_REFS_ID_SIZE];
+	FILE *f = fopen(FSCRYPT_REFS, "r");
+	int found = 0;
+
+	if (!f)
+		return 0;
+	while (!found && fscanf(f, "%15s %32s", n, h) == 2)
+		if (fscrypt_refs_parse(h, cur) && memcmp(cur, id, FSCRYPT_REFS_ID_SIZE) == 0) {
+			snprintf(name, len, "%s", n);
+			found = 1;
+		}
+	fclose(f);
+	return found;
+}
+
+/* "DK", "DE0", "CE0" -> key identifier */
+static inline int fscrypt_refs_id(const char *name, uint8_t *id)
+{
+	char n[16], h[2 * FSCRYPT_REFS_ID_SIZE + 1];
+	FILE *f = fopen(FSCRYPT_REFS, "r");
+	int found = 0;
+
+	if (!f)
+		return 0;
+	while (!found && fscanf(f, "%15s %32s", n, h) == 2)
+		if (strcmp(n, name) == 0)
+			found = fscrypt_refs_parse(h, id);
+	fclose(f);
+	return found;
+}
+
+#endif
