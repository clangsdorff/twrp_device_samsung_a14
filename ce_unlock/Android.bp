// Built as a system binary because the 12.1 tree has no recovery variant of these libs;
// TW_RECOVERY_ADDITIONAL_RELINK_BINARY_FILES puts it in the ramdisk.
cc_binary {
    name: "ce_unlock",
    srcs: ["ce_unlock.cpp"],
    shared_libs: [
        "libbinder_ndk",
        "libcrypto",
        "liblog",
        "libsqlite",
    ],
    static_libs: [
        "android.hardware.security.keymint-V1-ndk_platform",
        "android.hardware.security.secureclock-V1-ndk_platform",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}

cc_binary {
    name: "gk_verify",
    srcs: ["gk_verify.cpp"],
    shared_libs: [
        "android.hardware.gatekeeper@1.0",
        "libhidlbase",
        "liblog",
        "libutils",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}
